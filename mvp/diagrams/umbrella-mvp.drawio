          <mxGeometry x="1160" y="792" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mdash-note12" value="Фильтры: статус, severity, бизнес-услуга, ИТ-сервис, КЕ, тип КЕ, команда, источник, метод RED/USE, состояние в PagerDuty, резервное оповещение, период. Значения ограничены областью роли." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">

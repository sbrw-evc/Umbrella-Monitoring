  <diagram id="cing" name="C4-3 Ingest Gateway">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cing-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Ingest Gateway: приём push-событий · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cing-bnd" value="&lt;b&gt;Ingest Gateway&lt;/b&gt; [Container: Go]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="175" width="1010" height="365" as="geometry" />
        </mxCell>
        <mxCell id="cing-lst" value="&lt;b&gt;HTTP Listener&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;POST /ingest/{connector}; за ingress и WAF; HTTPS 8443 mTLS от ingress&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="cing-guard" value="&lt;b&gt;Size &amp;amp; Format Guard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Лимит тела 1 МБ, content-type, пачки до 1000 событий&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="240" width="210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="cing-auth" value="&lt;b&gt;Auth Verifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Токен или HMAC коннектора, подпись облака; ключи из хранилища секретов&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="240" width="210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="cing-rate" value="&lt;b&gt;Rate Limiter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Лимиты на коннектор и IP; при превышении 429&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="230" height="104" as="geometry" />
        </mxCell>
        <mxCell id="cing-pub" value="&lt;b&gt;Publisher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Пишет в ingest.in и ждёт PubAck от JetStream&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="230" height="104" as="geometry" />
        </mxCell>
        <mxCell id="cing-resp" value="&lt;b&gt;Responder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;2xx только после PubAck; 503 при недоступной шине, источник повторит&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="210" height="104" as="geometry" />

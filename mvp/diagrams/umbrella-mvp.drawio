        <mxCell id="cwdg-edge4" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwdg-trk" target="cwdg-slo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-edge5" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwdg-slo" target="cwdg-hb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

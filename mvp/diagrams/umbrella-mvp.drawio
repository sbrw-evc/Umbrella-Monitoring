        <mxCell id="flc-note19" value="П-07 · OIDC 443: вход,&lt;br&gt;группы в claims" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#404040;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="505.0" y="781.0" width="130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="flc-edge20" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.7778;exitDx=0;exitDy=0;entryX=0.2045;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="flc-idp" target="flc-umb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="840" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="flc-note21" value="П-07 · SCIM 2.0, 443:&lt;br&gt;push групп" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#404040;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="530.0" y="826.0" width="130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="flc-edge22" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.4545;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flc-umb" target="flc-dir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flc-note23" value="П-07 · LDAPS 636:&lt;br&gt;группы раз в 15 мин" style="text;html=1;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#404040;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="730.0" y="664.0" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="flc-note24" value="Все внешние потоки идут по TLS. Входящие потоки (П-02, П-05, SCIM в П-07) принимаются только с проверкой подписи или токена; исходящие к источникам и PagerDuty (П-01, П-04, П-05) выполняются с повторами и не создают дублей: подтверждение источнику отправляется после записи в шину, а в PagerDuty уходит один dedup_key на тревогу. Резервные каналы (П-08) включаются, только если тревогу error или critical PagerDuty не принял за 2 минуты. Umbrella не хранит метрики, логи и трейсы: Grafana читает их из существующих хранилищ (пунктир — вне Umbrella). Подробности каждого потока — в таблице потоков." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1720" height="50" as="geometry" />
        </mxCell>

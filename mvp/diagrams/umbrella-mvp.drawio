        <mxCell id="bus-lgs3" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="954" y="830" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bus-lgt3" value="Заголовок таблицы" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">

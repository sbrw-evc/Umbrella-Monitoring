        <mxCell id="ha-sf5" value="&lt;b&gt;Недоступен PagerDuty&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;strokeWidth=2;" vertex="1" parent="1">

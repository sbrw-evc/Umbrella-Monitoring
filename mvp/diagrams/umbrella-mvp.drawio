          <mxGeometry x="654" y="1059" width="40" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dep-lgt2" value="Хранилище данных" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="702" y="1061" width="242" height="28" as="geometry" />
        </mxCell>
        <mxCell id="dep-lgs3" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="954" y="1063" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="dep-lgt3" value="Pod, который разворачивается по условию (Grafana OSS)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">

  <diagram id="ha" name="Отказоустойчивость и восстановление">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ha-note1" value="&lt;b&gt;Отказоустойчивость и восстановление: RPO ≤ 1 мин, RTO ≤ 1 ч (холодный резерв) · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ha-site" value="&lt;b&gt;Основная площадка&lt;/b&gt; [Kubernetes, без единой точки отказа]" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;align=right;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1000" height="380" as="geometry" />
        </mxCell>
        <mxCell id="ha-ingr" value="&lt;b&gt;Ingress-контроллер ×2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[на разных узлах]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;за reverse proxy + WAF ×2 в DMZ (VRRP)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ha-apps" value="&lt;b&gt;Сервисы Umbrella&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Deployment ×2 и больше, HPA, PDB]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;anti-affinity; Watchdog и CMDB Discovery ×2 с выбором лидера&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ha-ob" value="&lt;b&gt;Outbox и Fallback Notifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[таблица PostgreSQL, контейнер]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;тревога error или critical, не принятая PagerDuty за 2 мин, уходит по резервным каналам&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="260" height="115" as="geometry" />

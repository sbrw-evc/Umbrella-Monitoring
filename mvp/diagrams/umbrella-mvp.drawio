        <mxCell id="mdash-note10" value="Полнотекстовый поиск по заголовку, КЕ, сервису и тексту событий: индексы PostgreSQL full-text и trigram." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">

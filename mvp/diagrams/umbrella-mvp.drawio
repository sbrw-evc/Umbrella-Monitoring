        <mxCell id="road-m2" value="М2" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">

        <mxCell id="erd-tpl" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;EventTemplate · шаблон&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;source_id FK&lt;br&gt;mapping: JSONata, CEL&lt;br&gt;summary, severity&lt;br&gt;dedup_labels" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="erd-rule" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;Rule · правило RED/USE&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;method: red, use&lt;br&gt;target: сервис, тип КЕ&lt;br&gt;expr, threshold, window" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="230" height="86" as="geometry" />
        </mxCell>
        <mxCell id="erd-disc" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;DiscoveryRule · обнаружение&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;connector_id FK → Connector&lt;br&gt;object_types&lt;br&gt;match: теги, группы ресурсов&lt;br&gt;schedule&lt;br&gt;apply: авто или ревью" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="376" width="230" height="114" as="geometry" />
        </mxCell>
        <mxCell id="erd-crule" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;ContextRule · связь контекста&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;condition: тип КЕ, сигнал, сервис&lt;br&gt;traversal: тип связи, направление, глубина ≤ 3&lt;br&gt;layout (JSON)&lt;br&gt;time_window: −10 / +10 мин&lt;br&gt;version, status" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="230" height="114" as="geometry" />
        </mxCell>
        <mxCell id="erd-ptpl" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;PanelTemplate · шаблон панели&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;kind: метрики, логи, трейсы, сводка&lt;br&gt;datasource_uid (Grafana)&lt;br&gt;query_template: ${ci.host}, ${service}&lt;br&gt;allowed_vars" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="264" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="erd-mw" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;MaintenanceWindow · окно&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;scope: сервисы, КЕ&lt;br&gt;starts_at, ends_at&lt;br&gt;author, approver (два ключа)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">

        <mxCell id="inf-edge14" value="HTTPS 443: веб-UI, webhooks, SCIM;&lt;br&gt;syslog TLS 6514 от устройств" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1605;exitY=0;exitDx=0;exitDy=0;entryX=0.9167;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf-z_corp" target="inf-ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inf-edge15" value="HTTPS 8443 (mTLS)" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1034;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf-ingress" target="inf-svc">

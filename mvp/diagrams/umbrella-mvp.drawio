          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-edge7" value="KV lease" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7963;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwdg-lead" target="cwdg-nats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-edge8" value="тестовая команда" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwdg-cht" target="cwdg-fbn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-edge9" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cwdg-slo" target="cwdg-met">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-note10" value="Зонтичный мониторинг не может следить сам за собой, поэтому последняя линия защиты внешняя: heartbeat уходит, только если тестовая проба прошла конвейер до PagerDuty Gateway. Если Umbrella перестала работать целиком, ping прекращается и внешний сервис сам поднимает инцидент. Недоступность самой PagerDuty heartbeat не останавливает: её закрывает резервное оповещение." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lgbox" value="&lt;b&gt;Легенда&lt;/b&gt;" style="rounded=0;fillColor=#FAFAFA;strokeColor=#BBBBBB;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="20" y="730" width="1550" height="118" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lgs0" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="34" y="768" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lgt0" value="Контейнер или сервис Umbrella" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="82" y="766" width="242" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lgs1" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="334" y="768" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lgt1" value="Компонент внутри контейнера" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="382" y="766" width="242" height="28" as="geometry" />

        <mxCell id="cwdg-lgs2" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="634" y="768" width="40" height="24" as="geometry" />

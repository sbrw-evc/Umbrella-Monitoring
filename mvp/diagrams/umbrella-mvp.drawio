  <diagram id="cnt" name="C4-2 Контейнеры">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cnt-note1" value="&lt;b&gt;C4 · Уровень 2 · Контейнеры Umbrella · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cnt-bnd" value="&lt;b&gt;Umbrella&lt;/b&gt; [Software System]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="190" width="1306" height="760" as="geometry" />
        </mxCell>
        <mxCell id="cnt-eng" value="&lt;b&gt;Инженер мониторинга&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Собирает коннекторы, шаблоны, правила, связи контекста&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cnt-duty" value="&lt;b&gt;Дежурный инженер&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Звонок, push, SMS от PagerDuty; дашборд инцидентов, Grafana&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="30" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cnt-sec" value="&lt;b&gt;Хранилище секретов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: OpenBao ×3, Raft]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Все логины, пароли, токены, ключи и сертификаты; сервисы получают их через agent injector&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="215" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cnt-web" value="&lt;b&gt;Веб-интерфейс&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: React, TypeScript, React Flow]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Дашборд инцидентов, карта CMDB, low-code конструктор коннекторов, шаблонов, правил и связей контекста&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cnt-wd" value="&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Тестовое событие через весь конвейер, heartbeat во внешний сервис, тест резервных каналов&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="220" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cnt-fbn" value="&lt;b&gt;Fallback Notifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Резервное оповещение дежурных, когда PagerDuty не принял алерт&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="220" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cnt-ingest" value="&lt;b&gt;Ingest Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Приём webhook (push); отвечает 2xx только после записи в шину&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cnt-api" value="&lt;b&gt;Core API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go, REST + WebSocket]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Конфигурация, тревоги, дашборд инцидентов, карта CMDB, RBAC, синхронизация групп каталога&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cnt-pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: PostgreSQL 16]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Коннекторы, курсоры, CMDB и РСМ, тревоги, роли, связи контекста, аудит&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="415" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cnt-pdg" value="&lt;b&gt;PagerDuty Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Events API v2 с dedup_key, повторы; webhooks; кеш дежурств&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="420" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cnt-bus" value="&lt;b&gt;Шина событий&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: NATS JetStream]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ingest.in, events.raw, events.dlq, events.norm, alerts.changed, alerts.commands, pd.delivery, pd.inbound, connector.query, connector.command, cmdb.changed, notify.log; запрос-ответ context.request&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="1246" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cnt-conn" value="&lt;b&gt;Connector Runtime&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Исполняет low-code коннекторы: API, SQL, очереди, облака, syslog; курсоры, парсинг, ack источнику&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="760" width="196" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cnt-rule" value="&lt;b&gt;Rule Engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Тревоги по RED и USE; метрики запрашивает у коннекторов&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="760" width="196" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cnt-norm" value="&lt;b&gt;Normalizer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Go, CEL, JSONata]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Маппинг и шаблоны, кандидат КЕ, сигнал, ключ дедупликации&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

        <mxCell id="cld-ev3" value="&lt;b&gt;Событие без ресурса&lt;/b&gt;&lt;br&gt;&lt;font style='font-family:Courier New;font-size:10px'&gt;id: 5c1e…-guid&lt;br&gt;text: disk latency high&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cld-res" value="&lt;b&gt;Identity Resolver: порядок поиска КЕ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;1. Устойчивый тег ресурса (service, ci, host)&lt;br&gt;&lt;br&gt;2. Логическая группа: autoscaling group, сервис контейнеров, deployment&lt;br&gt;&lt;br&gt;3. Запрос по ID в API облака: теги и группа&lt;br&gt;&lt;br&gt;4. DNS-имя или IP с проверкой по времени события&lt;br&gt;&lt;br&gt;5. Не нашли: КЕ аккаунта, региона и облачного сервиса + очередь «без КЕ» для инженера&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="420" height="320" as="geometry" />
        </mxCell>
        <mxCell id="cld-capi" value="&lt;b&gt;API облака&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;описание ресурса по ID, теги, группа&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

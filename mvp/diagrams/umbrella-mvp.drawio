        <mxCell id="erd-conn" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;Connector · коннектор&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;source_id FK&lt;br&gt;name&lt;br&gt;current_version_id FK&lt;br&gt;secret_ref → хранилище секретов" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="236" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="erd-ver" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;ConnectorVersion&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;connector_id FK&lt;br&gt;n&lt;br&gt;graph: блоки (JSON)&lt;br&gt;status: draft, published&lt;br&gt;author, created_at" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="376" width="230" height="114" as="geometry" />

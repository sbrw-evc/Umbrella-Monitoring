        <mxCell id="erd-source" value="&lt;div style='font-size:12px;text-align:center'&gt;&lt;b&gt;Source · источник&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;id PK&lt;br&gt;name&lt;br&gt;kind: api, db, queue, cloud, push&lt;br&gt;ack_mode" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">

          <mxGeometry x="1153" y="960" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ctx-edge19" value="heartbeat&lt;br&gt;[HTTPS]" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.6374;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-umb" target="ctx-hb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx-s3" value="&lt;b&gt;Объектное хранилище S3&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Резервные копии; другая площадка или регион&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1470" y="960" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ctx-edge20" value="резервные копии&lt;br&gt;[HTTPS 443]" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.913;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-umb" target="ctx-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ctx-note21" value="Umbrella не привязана к конкретным системам мониторинга: подключение к любому источнику собирается из блоков в low-code конструкторе. Основной канал оповещения — PagerDuty: один алерт на проблему уходит туда, а PagerDuty по расписаниям и escalation policy звонит, шлёт push, SMS и email. Если PagerDuty не принял алерт severity error или critical за 2 минуты, Umbrella сама оповещает дежурных по резервным каналам. Статусы ack и resolve возвращаются в Umbrella и дальше в источники. Дежурный работает в дашборде инцидентов Umbrella; по клику Umbrella строит дашборд инцидента в Grafana (метрики, логи и трейсы берутся из существующих хранилищ, Umbrella их не хранит). Доступ к функциям, областям и предустановкам дашборда задаётся ролями по группам корпоративного каталога (AD); аудит уходит в SIEM." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="2200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ctx-lgbox" value="&lt;b&gt;Легенда&lt;/b&gt;" style="rounded=0;fillColor=#FAFAFA;strokeColor=#BBBBBB;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="2230" height="84" as="geometry" />
        </mxCell>

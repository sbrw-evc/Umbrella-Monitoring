        <mxCell id="sig-lgt0" value="Внешняя система или инфраструктура" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">

        <mxCell id="road-m1" value="М1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="205" height="30" as="geometry" />

        <mxCell id="cld-ci" value="&lt;b&gt;КЕ payments-api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;логическая группа payments-asg&lt;br&gt;3 инстанса · теги service=payments&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">

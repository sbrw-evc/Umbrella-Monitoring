  <diagram id="cweb" name="C4-3 Веб-интерфейс">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cweb-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты веб-интерфейса (React, TypeScript, React Flow) · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cweb-grp" value="&lt;b&gt;Представления&lt;/b&gt;" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="770" height="450" as="geometry" />
        </mxCell>
        <mxCell id="cweb-bnd" value="&lt;b&gt;Веб-интерфейс&lt;/b&gt; [Container: SPA на React, раздаётся nginx]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="1130" height="510" as="geometry" />
        </mxCell>
        <mxCell id="cweb-dash" value="&lt;b&gt;Дашборд инцидентов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Таблица и карточки, счётчики по severity, фильтры, полнотекстовый поиск, сохранённые представления, предустановки группы, живые обновления; клик → Grafana&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-side" value="&lt;b&gt;Боковая панель инцидента «i»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;События, хронология, статус в PagerDuty, журнал резервных отправок; ack и silence по правам&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="150" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-map" value="&lt;b&gt;Карта CMDB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Граф КЕ и сервисов со статусами; ревью изменений карты&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="150" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-builder" value="&lt;b&gt;Конструктор коннекторов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Холст React Flow, палитра блоков, dry-run на живых данных&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="290" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-editors" value="&lt;b&gt;Редакторы шаблонов и правил&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Шаблоны источников и событий, RED/USE, дедупликация; CEL, JSONata&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="290" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-ctxl" value="&lt;b&gt;Редактор «Связи контекста»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Low-code редактор правил для Grafana: условие → обход карты → панели; dry-run на инциденте&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="290" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-maint" value="&lt;b&gt;Окна и маршрутизация&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Окна обслуживания, маршруты в PagerDuty, резервные контакты и каналы&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="430" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-roles" value="&lt;b&gt;Роли и предустановки&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Привязка групп каталога к ролям, областям и предустановкам дашборда; два ключа&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="430" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-admin" value="&lt;b&gt;Администрирование&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Пользователи, команды, журнал аудита, ошибки разбора, самоконтроль&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="430" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cweb-shell" value="&lt;b&gt;App Shell&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Вход через OIDC (PKCE), обновление токена, скрытие разделов по разрешениям роли&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">

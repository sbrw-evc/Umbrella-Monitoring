    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bld-note1" value="&lt;b&gt;Low-code конструктор коннекторов: подключение к любому источнику из блоков · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bld-note2" value="&lt;b&gt;Палитра блоков&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bld-cat0" value="&lt;b&gt;Триггеры&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;расписание, webhook из ingest.in, подписка на очередь, событие облака, ручной запуск&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="bld-cat1" value="&lt;b&gt;Получение&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTP REST / GraphQL / JSON-RPC / SOAP, SQL-запрос, очередь (Kafka, AMQP, NATS), syslog и файлы, почта, SNMP trap, API облака&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="167" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="bld-cat2" value="&lt;b&gt;Авторизация&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;токен, Basic, OAuth2, mTLS, IAM-роль облака, логин БД; секреты из OpenBao&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="239" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="bld-cat3" value="&lt;b&gt;Управление&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;пагинация, цикл по элементам, условие, задержка, повтор с backoff&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="311" width="320" height="64" as="geometry" />
        </mxCell>
        <mxCell id="bld-cat4" value="&lt;b&gt;Парсинг&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;JSON, XML, CSV, regex, Grok, key=value, syslog, разбиение пачки&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;" vertex="1" parent="1">

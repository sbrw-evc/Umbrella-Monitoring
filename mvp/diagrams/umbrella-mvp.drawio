        <mxCell id="road-m3" value="М3" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="70" width="205" height="30" as="geometry" />
        </mxCell>
        <mxCell id="road-m4" value="М4" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1015" y="70" width="205" height="30" as="geometry" />
        </mxCell>
        <mxCell id="road-m5" value="М5" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1220" y="70" width="205" height="30" as="geometry" />
        </mxCell>
        <mxCell id="road-m6" value="М6" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#438DD5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1425" y="70" width="205" height="30" as="geometry" />
        </mxCell>
        <mxCell id="road-n0" value="&lt;b&gt;1. Каркас&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b0" value="Репозиторий, OpenBao, схема БД,&lt;br&gt;модель события, вход через OIDC" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="404" y="112" width="197" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-n1" value="&lt;b&gt;2. Сбор и шаблоны&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="194" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b1" value="Конструктор коннекторов, парсеры, ack и inbox, шаблоны,&lt;br&gt;нагрузочный тест 10 000 событий в минуту" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="609" y="196" width="402" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-n2" value="&lt;b&gt;3. Карта CMDB и роли&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="278" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b2" value="Обнаружение КЕ, плавающие облачные ID, ревью карты, РСМ;&lt;br&gt;ролевая модель и синхронизация с каталогом (AD)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="814" y="280" width="402" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-n3" value="&lt;b&gt;4. Тревоги и дашборд инцидентов&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="362" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b3" value="Схлопывание, окна обслуживания, RED и USE, влияние по РСМ;&lt;br&gt;дашборд инцидентов: фильтры, поиск, предустановки" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1019" y="364" width="402" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-n4" value="&lt;b&gt;5. PagerDuty, резервные каналы, контекст в Grafana&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="446" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b4" value="Events API, webhooks, sync-back, кеш дежурств, почта и webhook, Watchdog;&lt;br&gt;Context Builder, связи контекста, дашборды инцидентов в Grafana" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1224" y="448" width="402" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-n5" value="&lt;b&gt;Пилот&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#DDDDDD;fontSize=10;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="road-b5" value="3 VM, 2–3 источника,&lt;br&gt;одна команда дежурных" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1429" y="532" width="197" height="68" as="geometry" />
        </mxCell>
        <mxCell id="road-note2" value="Каждый этап заканчивается работающей системой, которую можно показать. Резервное оповещение входит уже в MVP (почта и webhook): без него недоступность PagerDuty оставляет дежурных без алертов. Трудоёмкость MVP — 28–34 человеко-месяца." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1590" height="40" as="geometry" />
        </mxCell>
        <mxCell id="road-lgbox" value="&lt;b&gt;Легенда&lt;/b&gt;" style="rounded=0;fillColor=#FAFAFA;strokeColor=#BBBBBB;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1590" height="84" as="geometry" />

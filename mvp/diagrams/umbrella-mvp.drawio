        <mxCell id="capi-edge16" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.881;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="capi-nats" target="capi-ws">

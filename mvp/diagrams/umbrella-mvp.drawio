        <mxCell id="cctx-edge21" value="HTTPS 443, OIDC" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cctx-duty" target="cctx-graf">

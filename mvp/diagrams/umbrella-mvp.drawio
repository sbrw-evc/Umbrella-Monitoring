  <diagram id="cctx" name="C4-3 Context Builder">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cctx-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Context Builder: дашборд инцидента в Grafana · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cctx-bnd" value="&lt;b&gt;Context Builder&lt;/b&gt; [Container: Go]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="190" width="1290" height="550" as="geometry" />
        </mxCell>
        <mxCell id="cctx-api" value="&lt;b&gt;Context API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;context.request (request/reply), ответ: URL с интервалом времени; подписка alerts.changed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="260" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-rm" value="&lt;b&gt;Rule Matcher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Правило «Связи контекста» по типу КЕ, сигналу, сервису; опубликованная версия&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="260" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-rr" value="&lt;b&gt;Relation Resolver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Обход карты CMDB: тип связи, направление, глубина ≤ 3&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="260" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-vb" value="&lt;b&gt;Variable Binder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;${ci.host}, ${ci.name}, ${service}: экранирование под язык запроса, белый список шаблонов&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="260" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-tw" value="&lt;b&gt;Time Window&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Начало инцидента − 10 мин … закрытие или сейчас + 10 мин; настраивается в правиле&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="260" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-cache" value="&lt;b&gt;Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Готовый дашборд по инциденту и версии правил; сброс при изменении инцидента или правил&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="440" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-cln" value="&lt;b&gt;Cleanup Job&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Удаляет дашборды через 30 дней после закрытия инцидента&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="440" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-fts" value="&lt;b&gt;Folder &amp;amp; Team Sync&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Команды Grafana по группам каталога, права на папки по привязкам групп из PostgreSQL&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="440" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-aw" value="&lt;b&gt;Annotation Writer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Аннотации с событиями инцидента: открытие, ack, эскалации, resolve&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1130" y="440" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-dc" value="&lt;b&gt;Dashboard Composer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;JSON дашборда: панели метрик, логов, трейсов, сводка инцидента; раскладка; uid umb-‹id›&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="440" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cctx-gc" value="&lt;b&gt;Grafana Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;HTTP API Grafana: POST /api/dashboards/db (идемпотентно, папка команды), аннотации, команды и права папок; токен сервисного аккаунта из хранилища секретов; права только на папки Umbrella&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="620" width="990" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cctx-nats" value="&lt;b&gt;NATS JetStream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;context.request, alerts.changed&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="170" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cctx-pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;связи контекста, шаблоны панелей, карта CMDB, привязки групп&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

        <mxCell id="capi-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Core API (Go, REST + WebSocket) · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="capi-bnd" value="&lt;b&gt;Core API&lt;/b&gt; [Container: Go]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="980" height="680" as="geometry" />
        </mxCell>
        <mxCell id="capi-grp" value="&lt;b&gt;Сервисы домена&lt;/b&gt;" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="540" y="260" width="730" height="490" as="geometry" />
        </mxCell>
        <mxCell id="capi-rest" value="&lt;b&gt;REST Handlers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;OpenAPI /api/v1: валидация запросов, версии API; ссылки /go/…&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-authn" value="&lt;b&gt;AuthN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Проверка OIDC-токена, группы из claims при входе; сервисные токены с TTL&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-rbac" value="&lt;b&gt;AuthZ / RBAC Policy Engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Роли, разрешения на функции, области; объединение по группам; права себе не выдаются&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-dsync" value="&lt;b&gt;Directory Sync&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Группы каталога UMB-*: LDAPS pull раз в 15 мин или SCIM 2.0 push; отзыв сессий и токенов&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="130" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-audit" value="&lt;b&gt;Audit Logger&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Неизменяемый журнал всех изменений и действий; выгрузка в SIEM&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="290" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-ws" value="&lt;b&gt;WebSocket Hub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Живые обновления дашборда: alerts.changed, pd.delivery&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="450" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-pres" value="&lt;b&gt;Presets Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Предустановки дашборда по группам, сохранённые представления; версии&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-srch" value="&lt;b&gt;Incident Query &amp;amp; Search&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Фильтры, полнотекстовый поиск (FTS и триграммы PostgreSQL), экспорт CSV&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-ctxl" value="&lt;b&gt;Context Link&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;GET /go/incidents/{id}/grafana → context.request → redirect в Grafana&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="290" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-cfg" value="&lt;b&gt;Config Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Коннекторы, шаблоны, правила, связи контекста: версии, публикация, откат; два ключа&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="450" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-dry" value="&lt;b&gt;Dry-run Runner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Прогон черновика на примере через NATS request/reply в песочнице&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="450" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-act" value="&lt;b&gt;Alert Actions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ack, silence, комментарии → alerts.commands; проверка одноразового ack-токена, вход через IdP&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="450" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-mapq" value="&lt;b&gt;CMDB и РСМ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Чтение карты, ревью изменений, бизнес-услуги, резервные контакты&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="610" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-sec" value="&lt;b&gt;Secrets Broker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Кладёт введённые логины и токены в хранилище секретов, в БД пишет только ссылку&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="610" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capi-web" value="&lt;b&gt;Веб-интерфейс&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SPA&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

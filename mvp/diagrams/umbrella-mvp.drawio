  <diagram id="rbac" name="Ролевая модель">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rbac-note1" value="&lt;b&gt;Ролевая модель: группы каталога → привязки → роль, область, предустановки дашборда → пользователь · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rbac-ad" value="&lt;b&gt;Корпоративный каталог (AD)&lt;/b&gt;" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="290" height="440" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g0" value="UMB-oncall-payments" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g1" value="UMB-oncall-web" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="164" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g2" value="UMB-mon-engineers" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="218" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g3" value="UMB-svc-owners-payments" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="272" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g4" value="UMB-auditors" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g5" value="UMB-role-admins" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-g6" value="UMB-umbrella-admins" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="434" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rbac-idp" value="&lt;b&gt;Корпоративный IdP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;OIDC: claims групп при входе&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rbac-ds" value="&lt;b&gt;Directory Sync&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Компонент Core API]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;LDAPS 636: опрос каждые 15 мин (OU, префикс UMB-*) или SCIM 2.0 push от IdP. Удалён из группы → отзыв при следующей синхронизации (≤ 15 мин), сессии и токены отозваны&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="180" width="240" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rbac-gb" value="&lt;b&gt;Привязки групп (GroupBinding)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;группа → роль + область + предустановки&lt;br&gt;&lt;br&gt;пример: UMB-oncall-payments → Дежурный инженер; область: бизнес-услуга «Платежи», команда payments; предустановка «Дежурство payments»&lt;br&gt;&lt;br&gt;изменение — в два ключа: администратор ролей и второй подтверждающий; запись в аудит&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="rbac-role" value="&lt;b&gt;Роль&lt;/b&gt; — набор разрешений на функции&lt;br&gt;&lt;font style='font-size:10px;font-family:Courier New'&gt;dashboard.view, incident.ack, incident.silence, connector.edit, connector.publish, template.edit, rule.edit, maintenance.create, maintenance.approve, cmdb.review, routing.edit, contacts.edit, context.edit, presets.edit, roles.admin, audit.read&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="70" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rbac-scope" value="&lt;b&gt;Область&lt;/b&gt; — на чём действуют разрешения:&lt;br&gt;&lt;font style='font-size:11px'&gt;бизнес-услуги, ИТ-сервисы, команды, коннекторы и источники&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="265" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rbac-preset" value="&lt;b&gt;Предустановки дашборда&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;фильтры (например, сервисы команды), колонки, группировка и сортировка, виджеты, автообновление, правила связей контекста, папка Grafana; версии&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="380" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rbac-user" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Права — объединение прав всех его групп, область — объединение областей. Видит все предустановки своих групп, по умолчанию — группы с высшим приоритетом. Личные представления только внутри области&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

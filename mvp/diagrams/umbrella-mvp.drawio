        <mxCell id="gfs-fr1221" value="[Grafana недоступна]" style="rounded=0;fillColor=none;strokeColor=#9673A6;strokeWidth=1.5;html=1;verticalAlign=top;align=left;spacingLeft=110;spacingTop=2;fontSize=10;fontStyle=1;fontColor=#5A3D73;" vertex="1" parent="1">

          <mxGeometry x="837" y="960" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ctx-edge18" value="аудит&lt;br&gt;[syslog TLS 6514]" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3626;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctx-umb" target="ctx-siem">
          <mxGeometry relative="1" as="geometry" />

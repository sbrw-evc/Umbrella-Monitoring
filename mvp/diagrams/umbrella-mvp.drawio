  <diagram id="cfbn" name="C4-3 Fallback Notifier">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cfbn-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Fallback Notifier: резервное оповещение, когда PagerDuty недоступен · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-bnd" value="&lt;b&gt;Fallback Notifier&lt;/b&gt; [Container: Go]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="1040" height="420" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-lst" value="&lt;b&gt;Alert &amp;amp; Delivery Listener&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;alerts.changed и pd.delivery: что отправлено и что PagerDuty принял&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-det" value="&lt;b&gt;Failover Detector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Тревога error или critical не принята за 2 мин с открытия (отсчёт идёт и при открытом circuit breaker)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-rcp" value="&lt;b&gt;Recipient Resolver&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Дежурные из кеша расписаний; кеш пуст или старше 24 ч → резервные контакты сервиса&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-comp" value="&lt;b&gt;Message Composer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Текст по шаблону события, ссылка на контекст в Grafana, ссылка подтверждения, сводка при шторме&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="240" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-rcv" value="&lt;b&gt;Recovery Notifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PagerDuty снова принимает: сообщение «канал восстановлен», итог по тревогам&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-log" value="&lt;b&gt;Delivery Log&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Журнал отправок в PostgreSQL, защита от повторов, лимиты на канал; notify.log&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="410" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-esc" value="&lt;b&gt;Escalation Timer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Нет подтверждения 10 мин → резервным контактам сервиса&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="410" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-ad" value="&lt;b&gt;Channel Adapters&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;почта (SMTP 587 через корпоративный релей), HTTPS webhook во внутренний мессенджер&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="410" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-nats" value="&lt;b&gt;NATS JetStream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;alerts.changed, pd.delivery, notify.log&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="150" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;кеш дежурств, резервные контакты, журнал отправок&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="60" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cfbn-smtp" value="&lt;b&gt;Корпоративный почтовый релей&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SMTP 587 TLS, внутренняя сеть&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

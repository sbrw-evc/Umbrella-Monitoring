        <mxCell id="capi-siem" value="&lt;b&gt;SIEM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;журнал аудита&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="160" height="100" as="geometry" />

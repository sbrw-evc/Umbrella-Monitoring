        </mxCell>
        <mxCell id="cale-bnd" value="&lt;b&gt;Alert Engine&lt;/b&gt; [Container: Go]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">

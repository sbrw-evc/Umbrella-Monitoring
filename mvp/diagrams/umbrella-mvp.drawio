        <mxCell id="seq-note39" value="22. ack или silence в источнике" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontSize=10;align=right;verticalAlign=bottom;spacing=0;" vertex="1" parent="1">

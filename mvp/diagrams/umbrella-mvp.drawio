        <mxCell id="mgrf-note101" value="&lt;b&gt;Связи контекста → строки дашборда&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1280" y="70" width="470" height="26" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-call1s" value="1" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="110" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-card1" value="&lt;b&gt;Сводка инцидента&lt;/b&gt; — блок «Сводка инцидента» есть в каждом дашборде; аннотации — события инцидента из Umbrella" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="106" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-call2s" value="2" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="174" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-card2" value="&lt;b&gt;Правило «Служба приложения: недоступность»&lt;/b&gt;&lt;br&gt;Условие: тип КЕ = служба приложения, сигнал = доступность&lt;br&gt;Обход: служба → «размещена на» → хост, глубина 1&lt;br&gt;Панели метрик: CPU, RAM, диск; шаблон запроса с ${ci.host}" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="170" width="440" height="72" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-call3s" value="3" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="260" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-card3" value="&lt;b&gt;То же правило, второй обход&lt;/b&gt;&lt;br&gt;Обход: служба → «использует» → БД, глубина 1&lt;br&gt;Панели метрик: соединения, время ответа; шаблон с ${ci.name}" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="256" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-call4s" value="4" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="334" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-card4" value="&lt;b&gt;Панель логов&lt;/b&gt;&lt;br&gt;Источник: хранилище логов; фильтр service = ${service}, уровень ≥ error" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="330" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-call5s" value="5" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#C0392B;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="394" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-card5" value="&lt;b&gt;Панель трейсов&lt;/b&gt;&lt;br&gt;Источник: хранилище трейсов; service = ${service}, status = error" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="390" width="440" height="46" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-cwin" value="&lt;b&gt;Окно времени&lt;/b&gt;: начало инцидента − 10 мин … закрытие (или сейчас) + 10 мин; правило может задать своё. Значения переменных экранируются, шаблоны запросов только из белого списка." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1312" y="450" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mgrf-ctgt" value="&lt;b&gt;Порядок применения&lt;/b&gt;: правила выбираются по условию, обход по карте CMDB — не глубже 3 уровней; если правило для типа КЕ не найдено, показываются базовые панели КЕ." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">

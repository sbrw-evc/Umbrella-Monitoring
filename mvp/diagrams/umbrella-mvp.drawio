        <mxCell id="capi-edge15" value="alerts.commands, context.request, connector.query" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.2192;exitY=1;exitDx=0;exitDy=0;entryX=0.2857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="capi-grp" target="capi-nats">

        <mxCell id="bus-lgs2" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#E1D5E7;strokeColor=#DDDDDD;fontSize=11;fontStyle=1;align=left;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="654" y="830" width="40" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bus-lgt2" value="Запрос контекста Grafana (request/reply)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="702" y="828" width="242" height="28" as="geometry" />

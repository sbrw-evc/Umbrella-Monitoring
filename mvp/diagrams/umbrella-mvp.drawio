        <mxCell id="capi-note17" value="alerts.changed,&lt;br&gt;pd.delivery" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=wrap;align=right;" vertex="1" parent="1">
          <mxGeometry x="398" y="640" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="capi-edge18" value="context.request&lt;br&gt;(request/reply)" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="capi-nats" target="capi-cb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="capi-note19" value="Каждый запрос проходит AuthN и RBAC Policy Engine (разрешение на функцию и область данных); каждое изменение пишется в аудит до ответа. Права выдаются через группы каталога: Directory Sync забирает группы по LDAPS раз в 15 минут или принимает SCIM; удаление из группы отзывает доступ, сессии и токены при следующей синхронизации. Context Link по клику на инцидент запрашивает Context Builder через context.request и перенаправляет браузер в Grafana. Secrets Broker сразу передаёт секреты в хранилище секретов и возвращает ссылку." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1570" height="60" as="geometry" />
        </mxCell>
        <mxCell id="capi-lgbox" value="&lt;b&gt;Легенда&lt;/b&gt;" style="rounded=0;fillColor=#FAFAFA;strokeColor=#BBBBBB;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1570" height="118" as="geometry" />

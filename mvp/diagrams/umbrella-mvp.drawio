  </diagram>
  <diagram id="ifc" name="Компоненты и интерфейсы">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ifc-note1" value="&lt;b&gt;Компоненты и интерфейсы: что каждый контейнер предоставляет и что использует · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ifc-eng" value="&lt;b&gt;Инженер&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-idp" value="&lt;b&gt;IdP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;● OIDC 443; SCIM-клиент&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-ad" value="&lt;b&gt;Каталог (AD)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;● LDAPS 636&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="70" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-siem" value="&lt;b&gt;SIEM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;● syslog TLS 6514&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-grf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;● HTTP API 443&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-bao" value="&lt;b&gt;Хранилище секретов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: OpenBao ×3, Raft]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;● 8200 TLS&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="60" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ifc-fbx" value="&lt;b&gt;Резервные каналы&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-pd" value="&lt;b&gt;PagerDuty&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1540" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-hb" value="&lt;b&gt;Внешний heartbeat&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1790" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ifc-web" value="&lt;b&gt;Веб-интерфейс&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● HTTPS 443: UI, конструктор, дашборд инцидентов&lt;br&gt;○ REST, WebSocket Core API&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-api" value="&lt;b&gt;Core API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● REST /api/v1 (OpenAPI), WebSocket /ws, GET /go/incidents/{id}/grafana, SCIM 2.0 /scim/v2&lt;br&gt;○ SQL; OIDC; LDAPS 636 (каталог); syslog TLS 6514 в SIEM; NATS: pub alerts.commands; request connector.query, context.request; sub alerts.changed, pd.delivery, notify.log, events.dlq&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="230" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-cb" value="&lt;b&gt;Context Builder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● NATS: context.request (request/reply)&lt;br&gt;○ Grafana HTTP API 443: дашборды, аннотации, команды и права папок; NATS: sub alerts.changed; SQL: связи контекста, шаблоны панелей, КЕ, тревоги; OpenBao: токен сервисного аккаунта Grafana&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="230" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-fbn" value="&lt;b&gt;Fallback Notifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● метрики /metrics&lt;br&gt;○ SMTP 587 (релей), HTTPS webhook; NATS: sub pd.delivery, alerts.changed; pub notify.log; SQL&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="230" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-pdg" value="&lt;b&gt;PagerDuty Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● POST /pd/webhook (подпись)&lt;br&gt;○ Events API v2, REST API PagerDuty; NATS: sub alerts.changed; pub pd.delivery, pd.inbound; SQL (outbox)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1540" y="230" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-wd" value="&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● метрики /metrics&lt;br&gt;○ тестовое событие в ingest.in; проба до PagerDuty Gateway; sub pd.delivery, notify.log, alerts.changed; ping heartbeat&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1790" y="230" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-ingest" value="&lt;b&gt;Ingest Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● POST /ingest/{connector} (HMAC или токен)&lt;br&gt;○ NATS: pub ingest.in&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-cr" value="&lt;b&gt;Connector Runtime&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● syslog TLS 6514 (приём); NATS: connector.query, connector.command&lt;br&gt;○ API, SQL, брокеры источников; sub ingest.in; pub events.raw, events.dlq&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-rule" value="&lt;b&gt;Rule Engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;○ NATS: request connector.query; pub events.raw; SQL: правила&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-norm" value="&lt;b&gt;Normalizer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;○ sub events.raw, cmdb.changed; pub events.norm, events.dlq; SQL: шаблоны, CMDB&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-alert" value="&lt;b&gt;Alert Engine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;○ sub events.norm, pd.inbound, alerts.commands, cmdb.changed; pub alerts.changed (outbox), connector.command; SQL&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-cmdb" value="&lt;b&gt;CMDB Discovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;● Map API (через Core API); pub cmdb.changed&lt;br&gt;○ инвентарь источников и облаков (API); SQL&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=6;verticalAlign=top;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="570" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ifc-nats" value="&lt;b&gt;NATS JetStream&lt;/b&gt; · ● 4222 TLS&lt;br&gt;&lt;font style='font-size:10px'&gt;ingest.in · events.raw · events.dlq · events.norm · alerts.changed · alerts.commands · pd.delivery · pd.inbound · connector.query · connector.command · cmdb.changed · notify.log · request/reply context.request&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

        <mxCell id="cale-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Alert Engine: тревоги, схлопывание, влияние · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">

  <diagram id="cwdg" name="C4-3 Watchdog">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cwdg-note1" value="&lt;b&gt;C4 · Уровень 3 · Компоненты Watchdog: самоконтроль конвейера · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-bnd" value="&lt;b&gt;Watchdog&lt;/b&gt; [Container: Go, 2 реплики, leader election]" style="rounded=1;arcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="990" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-gen" value="&lt;b&gt;Probe Generator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Раз в минуту тестовое событие в ingest.in; тестовый сервис PagerDuty: low urgency, auto-resolve&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-trk" value="&lt;b&gt;Pipeline Tracker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ждёт тестовую тревогу в alerts.changed и попытку отправки в pd.delivery&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-slo" value="&lt;b&gt;SLO Evaluator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Задержка событие → PagerDuty Gateway, доля успешных проб; p95 ≤ 30 с&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-hb" value="&lt;b&gt;Heartbeat Pinger&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ping внешнего heartbeat, если проба дошла до PagerDuty Gateway; не зависит от доступности PagerDuty&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="130" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-lead" value="&lt;b&gt;Leader Election&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Lease в NATS KV: пробы шлёт только лидер, вторая реплика в резерве&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="290" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-cht" value="&lt;b&gt;Channel Tester&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Раз в сутки тестовое сообщение по каждому резервному каналу&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-met" value="&lt;b&gt;Metrics Exporter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Метрики OpenMetrics: задержки, очереди, outbox&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="290" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-nats" value="&lt;b&gt;NATS JetStream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ingest.in, alerts.changed, pd.delivery, notify.log, KV lease&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="170" height="270" as="geometry" />
        </mxCell>
        <mxCell id="cwdg-ext" value="&lt;b&gt;Внешний heartbeat&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;поднимает инцидент, если ping пропал 3 мин&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">

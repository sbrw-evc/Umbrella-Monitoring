        <mxCell id="1" parent="0" />
        <mxCell id="road-note1" value="&lt;b&gt;Дорожная карта MVP: пять этапов и пилот за 6 месяцев · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />

        </mxCell>
        <mxCell id="cdb-lead" value="&lt;b&gt;Leader Election&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Lease в NATS KV: обнаружение ведёт одна реплика, вторая в резерве&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=12;" vertex="1" parent="1">

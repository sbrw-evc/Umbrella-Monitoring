  <diagram id="sig" name="RED и USE">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sig-note1" value="&lt;b&gt;Формирование алертов по RED и USE · MVP&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sig-g_red" value="&lt;b&gt;RED&lt;/b&gt; · ИТ-сервисы: что чувствует пользователь" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="700" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sig-g_use" value="&lt;b&gt;USE&lt;/b&gt; · ресурсы и КЕ: почему это происходит" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#888888;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="700" height="240" as="geometry" />
        </mxCell>
        <mxCell id="sig-r" value="&lt;b&gt;Rate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Интенсивность запросов, запросов в секунду&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; падение ниже базовой линии на 50% за 10 мин&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;счётчик запросов сервиса&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sig-e" value="&lt;b&gt;Errors&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Доля ошибочных ответов&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; расход бюджета ошибок SLO в 14,4 раза быстрее нормы за 1 ч&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;ответы 5xx / все ответы; ошибки в логах доступа&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="287" y="120" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sig-d" value="&lt;b&gt;Duration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Время ответа p95 / p99&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; p99 выше цели SLO дольше 5 мин&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;гистограмма времени ответа&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="514" y="120" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sig-u" value="&lt;b&gt;Utilization&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Занятость ресурса: CPU, память, диск, сеть&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; выше 90% дольше 15 мин или прогноз заполнения диска меньше 24 ч&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;метрики хоста, БД, облачного ресурса&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sig-s" value="&lt;b&gt;Saturation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Очередь к ресурсу: load average, swap, пул соединений, лаг репликации&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; load больше 2 × ядер или очередь растёт 10 мин&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;load, активные соединения, лаг очереди&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1027" y="120" width="206" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sig-ue" value="&lt;b&gt;Errors&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ошибки ресурса: I/O, сетевые, OOM, рестарты&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;i&gt;Алерт:&lt;/i&gt; любой рост счётчика за 5 мин&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#444444'&gt;счётчики ошибок I/O, рестарты, ERROR в логах КЕ&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">

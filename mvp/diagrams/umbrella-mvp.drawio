        <mxCell id="dep-pdg" value="&lt;b&gt;PagerDuty Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="500" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-fbn" value="&lt;b&gt;Fallback Notifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2, независим от PagerDuty Gateway&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-cmdb" value="&lt;b&gt;CMDB Discovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2, leader election&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="605" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-ctxb" value="&lt;b&gt;Context Builder&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="605" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-graf" value="&lt;b&gt;Grafana OSS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2, только если нет корпоративной Grafana; HTTPS 443 от Context Builder&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="605" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-wd" value="&lt;b&gt;Watchdog&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Pod]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;×2, leader election; heartbeat наружу&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="710" width="215" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-edge2" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-ctxb" target="dep-graf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-nats" value="&lt;b&gt;NATS JetStream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[StatefulSet ×3]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;R3; ingest.in, events.raw, events.norm 24 ч; events.dlq 14 дней; notify.log 30 дней; остальные 7 дней; 100 ГБ&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=20;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="905" y="290" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dep-pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[CloudNativePG / Patroni]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Primary + синхронная реплика (без строгого режима), PITR, archive_timeout ≤ 60 с; 500 ГБ&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="905" y="420" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dep-sec" value="&lt;b&gt;Хранилище секретов&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: OpenBao ×3, Raft]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;auto-unseal или Шамир 3 из 5; секреты подам через agent injector; снапшоты в S3&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="905" y="570" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dep-corp" value="&lt;b&gt;Корпоративные системы&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Исходящие из зоны приложений: IdP и каталог: LDAPS 636, SCIM 443; SIEM: syslog TLS 6514; корпоративная Grafana: HTTPS 443&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep-edge3" value="" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.1923;exitY=0;exitDx=0;exitDy=0;entryX=0.2679;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-nsapp" target="dep-corp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-lb" value="&lt;b&gt;Балансировщик и DMZ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[2 VM 2 vCPU / 4 ГБ]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Reverse proxy + WAF, egress-прокси; в кластер через Ingress-контроллер ×2 на разных узлах&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="60" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dep-edge4" value="HTTPS 8443 (mTLS)" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.8846;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-lb" target="dep-nsapp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-s3" value="&lt;b&gt;S3-совместимое хранилище&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[другая площадка или регион]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;WAL-архив и бэкапы PostgreSQL, снапшоты OpenBao&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="480" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dep-edge5" value="HTTPS 443" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8333;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-pg" target="dep-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-hb" value="&lt;b&gt;Внешний heartbeat&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Второй контур: поднимает тревогу, если Umbrella молчит&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1400" y="695" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dep-edge6" value="ping каждые 60 с" style="endArrow=block;endFill=1;endSize=6;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-wd" target="dep-hb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="207.5" y="865" />
              <mxPoint x="1350" y="865" />
              <mxPoint x="1350" y="750" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-note7" value="Поды без состояния масштабируются горизонтально; NATS распределяет работу через queue group (общий durable consumer). Watchdog раз в минуту прогоняет тестовое событие до PagerDuty Gateway, раз в сутки проверяет резервные каналы и шлёт heartbeat во внешний сервис. Если Umbrella перестала работать, внешний сервис сам поднимает тревогу (например, через свой сервис в PagerDuty): зонтичный мониторинг не может следить сам за собой. Grafana: используется корпоративная; если её нет, Grafana OSS ×2 разворачивается в зоне приложений, её база — в PostgreSQL. Все секреты — только в OpenBao." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="935" width="1600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dep-lgbox" value="&lt;b&gt;Легенда&lt;/b&gt;" style="rounded=0;fillColor=#FAFAFA;strokeColor=#BBBBBB;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1025" width="1640" height="118" as="geometry" />
        </mxCell>

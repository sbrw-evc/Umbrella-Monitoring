# install.sh writes .env with random secrets; copy this file by hand only if
# you run docker compose yourself.
PUBLIC_HOST=localhost          # server IP or DNS name, used in links and WebSocket origins
UMBRELLA_PORT=8080
ZABBIX_WEB_PORT=8081
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OSD_PORT=5601                  # OpenSearch Dashboards; OpenSearch itself is not published
UMBRELLA_DEMO=false            # true: demo CMDB and traffic next to the real lab events
UMBRELLA_PD_ROUTING_KEY=       # empty: PagerDuty dry-run
TZ=Europe/Moscow

# Umbrella accounts. Password policy: 10+ characters, letters and digits, not the login.
UMBRELLA_ADMIN_USER=admin
UMBRELLA_ADMIN_PASSWORD=change-me-1
LAB_OWNER_PASSWORD=change-me-2       # lab-owner, role owner of the business service lab-shop
UMBRELLA_GRAFANA_TOKEN=umb_change-me # API token of the service account "grafana" (role reader); must start with umb_
UMBRELLA_METRICS_TOKEN=              # bearer token for /metrics (Prometheus sends it); empty: /metrics is open

# Webhook tokens of the lab connectors (Umbrella reads them as UMB_SECRET_LAB_*).
ZABBIX_WEBHOOK_TOKEN=change-me       # Zabbix -> Umbrella
PROMETHEUS_WEBHOOK_TOKEN=change-me   # Alertmanager -> Umbrella
SMOKE_WEBHOOK_TOKEN=change-me        # smoke-test connectors

ZABBIX_DB_PASSWORD=change-me
ZABBIX_ADMIN_PASSWORD=change-me      # configure.sh sets it instead of the default "zabbix"
GRAFANA_ADMIN_PASSWORD=change-me

# Notifications. Empty: the channels "Lab Teams" and "Lab Zoom" post to the
# notify-sink container. Real webhooks need https.
LAB_ZOOM_TOKEN=change-me             # verification token sent to the sink
TEAMS_WEBHOOK_URL=                   # Teams Workflows "Post to a channel when a webhook request is received" URL
ZOOM_WEBHOOK_URL=                    # Zoom Incoming Webhook endpoint URL
ZOOM_VERIFICATION_TOKEN=             # Zoom Incoming Webhook verification token

# Image mirrors, when Docker Hub is not reachable (defaults in docker-compose.yml).
# PROMETHEUS_IMAGE= ALERTMANAGER_IMAGE= NODE_EXPORTER_IMAGE= OPENSEARCH_IMAGE=
# OSD_IMAGE= GRAFANA_IMAGE= SINK_IMAGE= POSTGRES_IMAGE=

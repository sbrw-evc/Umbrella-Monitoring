GRAFANA_IMAGE=grafana/grafana:13.2.3
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Ingest address and bearer token of the Umbrella connector built from the Grafana Alerting preset.
UMBRELLA_INGEST_URL=http://umbrella:8080/api/ingest/grafana
UMBRELLA_INGEST_TOKEN=change-me
TZ=UTC
